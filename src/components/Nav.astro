---
const links = [
  { href: '#about', label: 'About' },
  { href: '#craft', label: 'Craft' },
  { href: '#principles', label: 'Principles' },
  { href: '#shell', label: 'Shell' },
];
---

<header class="nav" id="nav">
  <div class="nav-inner">
    <a href="#top" class="logo" aria-label="Back to top">
      <span class="logo-mark">st</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="status" href="#connect">
      <span class="pulse" aria-hidden="true"></span>
      <span class="status-text">Ready</span>
    </a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 14px;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding-inline: 16px;
    transition: transform 0.5s var(--ease);
  }

  .nav.hidden {
    transform: translateY(-120%);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(12, 14, 19, 0.6);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.6);
  }

  .logo {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--text);
    color: var(--bg);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.04em;
  }


  ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0 6px;
    gap: 2px;
  }

  ul a {
    display: block;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 14px;
    color: var(--muted);
    transition:
      color 0.25s,
      background 0.25s;
  }

  ul a:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px 8px 12px;
    border-radius: 999px;
    background: var(--surface-2);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text);
  }

  .pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lime);
  }

  .pulse::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid var(--lime);
    animation: ping 2s var(--ease) infinite;
  }

  @keyframes ping {
    from {
      transform: scale(0.6);
      opacity: 1;
    }
    to {
      transform: scale(1.8);
      opacity: 0;
    }
  }

  @media (max-width: 560px) {
    ul a {
      padding: 8px 9px;
      font-size: 13px;
    }
    .status-text {
      display: none;
    }
    .status {
      padding: 8px;
    }
  }

  @media (max-width: 380px) {
    ul li:nth-child(4) {
      display: none;
    }
  }
</style>

<script>
  const nav = document.getElementById('nav');
  let last = window.scrollY;
  window.addEventListener(
    'scroll',
    () => {
      const y = window.scrollY;
      nav?.classList.toggle('hidden', y > last && y > 400);
      last = y;
    },
    { passive: true },
  );
  // Keep the nav visible while a keyboard user is tabbing through it.
  nav?.addEventListener('focusin', () => nav.classList.remove('hidden'));
</script>
