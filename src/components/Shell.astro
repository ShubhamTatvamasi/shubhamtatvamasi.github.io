<section id="shell" class="shell-section">
  <div class="container">
    <div class="head">
      <div>
        <span class="eyebrow" data-reveal>04 · Shell</span>
        <h2 class="section-title" data-reveal style="--d:.1s">
          <span class="mono prompt-mark">&gt;_</span> Talk to <span class="serif grad">the cluster</span>
        </h2>
      </div>
      <p class="intro" data-reveal style="--d:.2s">
        A tiny, very real-feeling terminal. Type <code>help</code> to look around, or try <code>nvidia-smi</code>.
      </p>
    </div>

    <div class="term" data-reveal id="term">
      <div class="bar">
        <span class="lights"><i></i><i></i><i></i></span>
        <span class="title mono">shubham@control-plane: ~</span>
        <span class="ctx mono">ctx: prod</span>
      </div>
      <div class="screen mono" id="screen" tabindex="-1">
        <div id="out"></div>
        <form id="form" class="line" autocomplete="off">
          <label for="cmd" class="ps1"><span class="u">shubham</span><span class="at">@</span><span class="h">k8s</span> <span class="p">~ ❯</span></label>
          <input id="cmd" name="cmd" spellcheck="false" autocapitalize="off" aria-label="Terminal command" />
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .shell-section {
    padding-block: clamp(80px, 12vw, 160px);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 48px;
  }

  .prompt-mark {
    color: var(--lime);
    font-size: 0.6em;
    vertical-align: middle;
    letter-spacing: -0.08em;
  }

  .intro {
    max-width: 380px;
    color: var(--muted);
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 2px 7px;
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--lime);
  }

  .term {
    border-radius: var(--radius);
    border: 1px solid var(--line-strong);
    background: #050608;
    overflow: hidden;
    box-shadow:
      0 40px 120px -40px rgba(139, 123, 255, 0.35),
      0 0 0 1px rgba(255, 255, 255, 0.02) inset;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
    background: var(--bg-2);
  }

  .lights {
    display: flex;
    gap: 7px;
  }

  .lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ff5f57;
  }
  .lights i:nth-child(2) {
    background: #febc2e;
  }
  .lights i:nth-child(3) {
    background: #28c840;
  }

  .title {
    font-size: 12px;
    color: var(--faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ctx {
    font-size: 11px;
    color: var(--lime);
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(198, 255, 61, 0.08);
  }

  .screen {
    height: clamp(380px, 56vh, 520px);
    overflow-y: auto;
    padding: 22px;
    font-size: 13.5px;
    line-height: 1.7;
    color: #cfd6e2;
    cursor: text;
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
  }

  .line {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }

  .ps1 {
    white-space: nowrap;
  }

  .u,
  :global(.t-u) {
    color: var(--lime);
  }
  .at {
    color: var(--faint);
  }
  .h {
    color: var(--cyan);
  }
  .p {
    color: var(--violet);
  }

  input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    outline: none;
    color: var(--text);
    font: inherit;
    caret-color: var(--lime);
  }

  #out :global(pre) {
    margin: 0 0 12px;
    font: inherit;
    white-space: pre;
    overflow-x: auto;
    scrollbar-width: none;
  }

  #out :global(.t-lime) {
    color: var(--lime);
  }
  #out :global(.t-cyan) {
    color: var(--cyan);
  }
  #out :global(.t-violet) {
    color: var(--violet);
  }
  #out :global(.t-pink) {
    color: var(--pink);
  }
  #out :global(.t-dim) {
    color: var(--faint);
  }
  #out :global(a) {
    color: var(--cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 560px) {
    .screen {
      font-size: 12px;
      padding: 16px;
    }
    .ctx {
      display: none;
    }
  }
</style>

<script>
  const out = document.getElementById('out')!;
  const form = document.getElementById('form') as HTMLFormElement;
  const input = document.getElementById('cmd') as HTMLInputElement;
  const screen = document.getElementById('screen')!;
  const term = document.getElementById('term')!;

  const PS1 =
    '<span class="t-lime">shubham</span><span class="t-dim">@</span><span class="t-cyan">k8s</span> <span class="t-violet">~ ❯</span> ';

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const pad = (s: string, n: number) => s + ' '.repeat(Math.max(0, n - s.length));
  const bar = (pct: number, len = 20) => {
    const f = Math.round((pct / 100) * len);
    return '█'.repeat(f) + '░'.repeat(len - f);
  };

  const commands: Record<string, (args: string[]) => string> = {
    help: () =>
      [
        '<span class="t-dim">available commands</span>',
        `  ${pad('whoami', 22)}who's on the other side`,
        `  ${pad('kubectl describe me', 22)}the full spec`,
        `  ${pad('kubectl get pods', 22)}what's running in my head`,
        `  ${pad('nvidia-smi', 22)}accelerator status`,
        `  ${pad('cat principles.md', 22)}how I build`,
        `  ${pad('git log --oneline', 22)}recent obsessions`,
        `  ${pad('neofetch', 22)}system info`,
        `  ${pad('github | linkedin', 22)}find me elsewhere`,
        `  ${pad('clear', 22)}wipe the screen`,
      ].join('\n'),

    whoami: () =>
      '<span class="t-lime">shubham tatvamasi</span>\nAI infrastructure engineer. I make GPUs, models and clusters behave like one calm system.',

    'kubectl describe me': () =>
      [
        `<span class="t-dim">Name:</span>         shubham-tatvamasi`,
        `<span class="t-dim">Kind:</span>         Engineer`,
        `<span class="t-dim">Labels:</span>       focus=ai-infrastructure`,
        `              craft=kubernetes,gpus,gitops,pqc`,
        `<span class="t-dim">Status:</span>       <span class="t-lime">Running</span>`,
        `<span class="t-dim">Restarts:</span>     0 (coffee-powered)`,
        `<span class="t-dim">Resources:</span>`,
        `  Limits:     curiosity=unbounded`,
        `  Requests:   hard-problems=always`,
        `<span class="t-dim">Events:</span>`,
        `  Normal  Reconciled   desired state == actual state`,
        `  Normal  Scaled       replicas before GPUs, as always`,
      ].join('\n'),

    'kubectl get pods': () =>
      [
        `<span class="t-dim">${pad('NAME', 34)}${pad('READY', 8)}${pad('STATUS', 12)}AGE</span>`,
        `${pad('vllm-llama-7c9f8-x2k4p', 34)}${pad('1/1', 8)}<span class="t-lime">${pad('Running', 12)}</span>4d`,
        `${pad('llm-d-epp-5d7b9-qq8sl', 34)}${pad('1/1', 8)}<span class="t-lime">${pad('Running', 12)}</span>4d`,
        `${pad('envoy-ai-gateway-6f4c-mn2', 34)}${pad('1/1', 8)}<span class="t-lime">${pad('Running', 12)}</span>9d`,
        `${pad('dcgm-exporter-k8x2z', 34)}${pad('1/1', 8)}<span class="t-lime">${pad('Running', 12)}</span>21d`,
        `${pad('flux-source-controller-0', 34)}${pad('1/1', 8)}<span class="t-lime">${pad('Running', 12)}</span>∞`,
        `${pad('weekend-plans-0', 34)}${pad('0/1', 8)}<span class="t-pink">${pad('Pending', 12)}</span>3y`,
      ].join('\n'),

    'nvidia-smi': () => {
      const rows = Array.from({ length: 4 }, (_, i) => {
        const u = i === 3 ? 4 : 55 + Math.round(Math.random() * 43);
        const t = 40 + Math.round(u / 2.5);
        const c = u < 10 ? 't-pink' : 't-lime';
        return `  GPU ${i}  ${t}°C  <span class="${c}">${bar(u)}</span> ${String(u).padStart(3)}%  ${u < 10 ? '<span class="t-pink">idle, allocated. fix me.</span>' : 'vllm'}`;
      });
      return [
        '<span class="t-dim">+--------------------------------------------------------+</span>',
        '  NVIDIA-SMI      Driver: latest      CUDA: yes',
        '<span class="t-dim">+--------------------------------------------------------+</span>',
        ...rows,
        '<span class="t-dim">+--------------------------------------------------------+</span>',
        '<span class="t-dim">  tip: allocated ≠ utilised. that\'s the whole job.</span>',
      ].join('\n');
    },

    'cat principles.md': () =>
      [
        '<span class="t-violet"># principles</span>',
        '1. Declare, don’t click.',
        '2. Measure the real thing.',
        '3. Scale the cheap layer first.',
        '4. Secure for the next decade.',
        '5. Open by default.',
      ].join('\n'),

    'git log --oneline': () =>
      [
        '<span class="t-violet">e1f0a9c</span> feat: kv-cache-aware routing for every model',
        '<span class="t-violet">b72d3e4</span> feat: gpu idle detection across vendors',
        '<span class="t-violet">9a4c1f2</span> feat: post-quantum certs as a CRD',
        '<span class="t-violet">4d8e6b1</span> refactor: replace runbooks with reconcilers',
        '<span class="t-violet">0c3b7a5</span> chore: delete the last manual deploy',
        '<span class="t-violet">0000001</span> init: curiosity',
      ].join('\n'),

    neofetch: () =>
      [
        '<span class="t-lime">   ▄▄▄▄▄▄▄   </span>  <span class="t-lime">shubham</span>@<span class="t-cyan">k8s</span>',
        '<span class="t-lime">  █ ▄▄▄ █ █  </span>  ---------------',
        '<span class="t-cyan">  █ ███ █ █  </span>  <span class="t-dim">OS:</span>       Kubernetes',
        '<span class="t-cyan">  █▄▄▄▄▄█ █  </span>  <span class="t-dim">Shell:</span>    zsh + kubectl',
        '<span class="t-violet">   ▀▀▀▀▀▀▀   </span>  <span class="t-dim">Accel:</span>    NVIDIA, AMD, whatever is idle',
        '               <span class="t-dim">Delivery:</span> Flux CD, Argo CD',
        '               <span class="t-dim">Crypto:</span>   ML-KEM-768, ML-DSA-65',
        '               <span class="t-dim">Uptime:</span>   since the first <span class="t-lime">kubectl apply</span>',
      ].join('\n'),

    github: () => {
      window.open('https://github.com/ShubhamTatvamasi', '_blank', 'noopener');
      return 'opening <a href="https://github.com/ShubhamTatvamasi" target="_blank" rel="noopener">github.com/ShubhamTatvamasi</a> …';
    },

    linkedin: () => {
      window.open('https://www.linkedin.com/in/shubhamtatvamasi', '_blank', 'noopener');
      return 'opening <a href="https://www.linkedin.com/in/shubhamtatvamasi" target="_blank" rel="noopener">linkedin.com/in/shubhamtatvamasi</a> …';
    },

    ls: () => 'principles.md  ideas.txt  <span class="t-dim">.weekend-plans (empty)</span>',
    'cat ideas.txt': () => 'scale replicas before nodes. cache before compute. route before you buy.',
    pwd: () => '/home/shubham/clusters/everywhere',
    date: () => new Date().toString(),
    uptime: () => 'up since the first reconcile loop. load average: curious, focused, caffeinated',
    echo: (a) => esc(a.join(' ')),
    sudo: () => '<span class="t-pink">nice try.</span> this incident will be reported to /dev/null.',
    'rm -rf /': () => '<span class="t-pink">blocked by admission policy:</span> deny-chaos-on-portfolio',
    exit: () => 'there is no exit. only reconciliation.',
    vim: () => 'you are now trapped. just kidding. <span class="t-dim">:q!</span>',
    hello: () => 'hey 👋 glad you found the shell.',
    hi: () => 'hey 👋 glad you found the shell.',
  };

  function print(cmd: string | null, html: string) {
    const pre = document.createElement('pre');
    pre.innerHTML = (cmd !== null ? PS1 + esc(cmd) + '\n' : '') + html;
    out.appendChild(pre);
    screen.scrollTop = screen.scrollHeight;
  }

  function run(raw: string) {
    const cmd = raw.trim().replace(/\s+/g, ' ');
    if (!cmd) return print('', '');
    if (cmd === 'clear') {
      out.innerHTML = '';
      return;
    }
    const lower = cmd.toLowerCase();
    let fn = commands[lower];
    let args: string[] = [];
    if (!fn) {
      if (lower.startsWith('sudo')) fn = commands.sudo;
      else if (lower.startsWith('echo ')) {
        fn = commands.echo;
        args = cmd.split(' ').slice(1);
      } else if (lower.startsWith('kubectl')) fn = () => 'try <span class="t-lime">kubectl get pods</span> or <span class="t-lime">kubectl describe me</span>';
      else if (lower === 'cd' || lower.startsWith('cd ')) fn = () => 'you are already exactly where you need to be.';
    }
    print(cmd, fn ? fn(args) : `<span class="t-pink">command not found:</span> ${esc(cmd)}. type <span class="t-lime">help</span>`);
  }

  const history: string[] = [];
  let hi = 0;

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const v = input.value;
    if (v.trim()) history.push(v);
    hi = history.length;
    input.value = '';
    run(v);
  });

  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowUp' && hi > 0) {
      input.value = history[--hi];
      e.preventDefault();
    } else if (e.key === 'ArrowDown') {
      hi = Math.min(history.length, hi + 1);
      input.value = history[hi] ?? '';
      e.preventDefault();
    } else if (e.key === 'Tab') {
      e.preventDefault();
      const v = input.value.toLowerCase();
      const match = Object.keys(commands).find((k) => k.startsWith(v) && v);
      if (match) input.value = match;
    } else if (e.key === 'l' && e.ctrlKey) {
      e.preventDefault();
      out.innerHTML = '';
    }
  });

  screen.addEventListener('click', () => {
    if (!window.getSelection()?.toString()) input.focus({ preventScroll: true });
  });

  // Auto-type an intro the first time the terminal scrolls into view.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let booted = false;
  async function boot() {
    if (booted) return;
    booted = true;
    print(null, '<span class="t-dim">last login: just now on ttys001 · type "help"</span>');
    const demo = 'kubectl describe me';
    if (!reduce) {
      for (const ch of demo) {
        input.value += ch;
        await new Promise((r) => setTimeout(r, 55 + Math.random() * 40));
      }
      await new Promise((r) => setTimeout(r, 300));
    }
    input.value = '';
    run(demo);
  }
  new IntersectionObserver(
    ([e], obs) => {
      if (e.isIntersecting) {
        boot();
        obs.disconnect();
      }
    },
    { threshold: 0.4 },
  ).observe(term);
</script>
