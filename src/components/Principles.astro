---
const principles = [
  {
    title: 'Declare, don’t click.',
    body: 'Every cluster, model and secret should be reproducible from a commit. If a human has to remember it, it will be forgotten.',
  },
  {
    title: 'Measure the real thing.',
    body: 'Allocated isn’t utilised. Ready isn’t responsive. I chase the metric that tells the truth, not the one that looks good on a dashboard.',
  },
  {
    title: 'Scale the cheap layer first.',
    body: 'Replicas before nodes, caches before GPUs, routing before hardware. Efficiency is a design decision, not a cost report.',
  },
  {
    title: 'Secure for the next decade.',
    body: 'Harvest-now, decrypt-later is real. Post-quantum crypto belongs in today’s pipelines, not tomorrow’s roadmap.',
  },
  {
    title: 'Open by default.',
    body: 'The best infrastructure ideas get sharper in public. Ship it, document it, let others break it.',
  },
];
---

<section class="principles" id="principles">
  <div class="container grid">
    <div class="sticky">
      <span class="eyebrow" data-reveal>04 · Principles</span>
      <h2 class="section-title" data-reveal style="--d:.1s">
        How I <span class="serif grad">think</span>
      </h2>
      <p class="sub" data-reveal style="--d:.2s">
        A short operating manual for the systems I build, and the way I build them.
      </p>
    </div>

    <ol>
      {
        principles.map((p, i) => (
          <li data-reveal>
            <span class="n mono">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .principles {
    padding-block: clamp(80px, 12vw, 160px);
    background:
      radial-gradient(800px 400px at 0% 0%, rgba(139, 123, 255, 0.08), transparent 70%),
      radial-gradient(600px 400px at 100% 100%, rgba(198, 255, 61, 0.05), transparent 70%);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: clamp(40px, 8vw, 120px);
  }

  .sticky {
    position: sticky;
    top: 120px;
    align-self: start;
  }

  .sub {
    margin-top: 24px;
    max-width: 360px;
    color: var(--muted);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  li {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 16px;
    padding: 30px 28px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: rgba(12, 14, 19, 0.7);
    transition:
      border-color 0.4s,
      transform 0.5s var(--ease);
  }

  li:hover {
    border-color: var(--line-strong);
    transform: translateX(6px);
  }

  .n {
    font-size: 13px;
    color: var(--lime);
    padding-top: 6px;
  }

  h3 {
    font-size: clamp(22px, 2.4vw, 30px);
    margin-bottom: 10px;
  }

  p {
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .sticky {
      position: static;
    }
  }

  @media (max-width: 480px) {
    li {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 24px 20px;
    }
  }
</style>
