---
const words = ['GPUs', 'tokens', 'clusters', 'packets', 'models', 'keys'];
---

<section class="hero" id="top">
  <canvas id="mesh" aria-hidden="true"></canvas>
  <div class="glow" aria-hidden="true"></div>

  <div class="container hero-inner">
    <p class="hello mono rise">
      <span class="tag">~/</span> shubham tatvamasi
    </p>

    <h1 class="headline">
      <span class="line rise" style="--d:.05s">I build the</span>
      <span class="line rise" style="--d:.15s"><span class="serif grad">quiet machinery</span></span>
      <span class="line rise" style="--d:.25s">behind intelligent</span>
      <span class="line rise" style="--d:.35s">systems.</span>
    </h1>

    <div class="hero-foot">
      <p class="lede rise" style="--d:.45s">
        Kubernetes-native inference, GPU platforms, GitOps and quantum-safe networks, engineered so models
        run fast, scale calmly and never go dark.
      </p>

      <div class="rotator mono rise" style="--d:.55s" aria-live="polite">
        <span class="muted">$ now orchestrating</span>
        <span class="word" id="word">{words[0]}</span><span class="caret">▍</span>
      </div>
    </div>

    <div class="ctas rise" style="--d:.65s">
      <a href="#craft" class="btn primary">
        Explore the craft
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
          ><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          ></path></svg
        >
      </a>
      <a href="#shell" class="btn ghost"><span class="mono">&gt;_</span> Open the shell</a>
    </div>
  </div>

  <a href="#about" class="scroll mono" aria-label="Scroll to about">
    <span>scroll</span>
    <span class="scroll-line"></span>
  </a>
</section>

<style>
  .hero {
    min-height: min(100svh, 1100px);
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: 120px 100px;
  }

  #mesh {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .glow {
    position: absolute;
    inset: -20% -10% auto auto;
    width: 70vw;
    height: 70vw;
    max-width: 900px;
    max-height: 900px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 30%, rgba(139, 123, 255, 0.28), transparent 60%),
      radial-gradient(circle at 70% 60%, rgba(61, 224, 255, 0.16), transparent 60%);
    filter: blur(40px);
    pointer-events: none;
    animation: drift 18s ease-in-out infinite alternate;
  }

  @keyframes drift {
    to {
      transform: translate(-12%, 14%) scale(1.1);
    }
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 200px;
    background: linear-gradient(transparent, var(--bg));
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    pointer-events: none;
  }

  .hero-inner a {
    pointer-events: auto;
  }

  .hello {
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 28px;
  }

  .tag {
    color: var(--lime);
  }

  .headline {
    font-size: clamp(48px, 10.5vw, 148px);
    line-height: 0.92;
    letter-spacing: -0.055em;
  }

  .headline .line {
    display: block;
  }

  .rise {
    opacity: 0;
    animation: rise 1s var(--ease) forwards;
    animation-delay: calc(var(--d, 0s) + 0.1s);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(30px);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  .headline .serif {
    font-size: 1.08em;
    letter-spacing: -0.03em;
    padding-right: 0.08em;
  }

  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 24px 48px;
    margin-top: 44px;
  }

  .lede {
    max-width: 520px;
    font-size: clamp(17px, 1.6vw, 20px);
    color: var(--muted);
  }

  .rotator {
    font-size: 14px;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(12, 14, 19, 0.6);
    backdrop-filter: blur(10px);
  }

  .muted {
    color: var(--faint);
    margin-right: 8px;
  }

  .word {
    color: var(--lime);
  }

  .caret {
    color: var(--lime);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 22px;
    border-radius: 999px;
    font-weight: 500;
    font-size: 15px;
    transition:
      transform 0.3s var(--ease),
      background 0.3s,
      box-shadow 0.3s;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .primary {
    background: var(--lime);
    color: #0a0c02;
    box-shadow: 0 0 0 0 rgba(198, 255, 61, 0.4);
  }

  .primary:hover {
    box-shadow: 0 10px 40px -6px rgba(198, 255, 61, 0.45);
  }

  .primary svg {
    transition: transform 0.3s var(--ease);
  }

  .primary:hover svg {
    transform: translateX(3px);
  }

  .ghost {
    border: 1px solid var(--line-strong);
    background: rgba(12, 14, 19, 0.5);
    backdrop-filter: blur(10px);
  }

  .ghost:hover {
    background: var(--surface-2);
  }

  .scroll {
    position: absolute;
    left: 50%;
    bottom: 28px;
    z-index: 2;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .scroll-line {
    width: 1px;
    height: 44px;
    background: linear-gradient(var(--line-strong), transparent);
    position: relative;
    overflow: hidden;
  }

  .scroll-line::after {
    content: '';
    position: absolute;
    left: 0;
    top: -40%;
    width: 1px;
    height: 40%;
    background: var(--lime);
    animation: fall 2s var(--ease) infinite;
  }

  @keyframes fall {
    to {
      top: 100%;
    }
  }

  @media (max-width: 640px) {
    .scroll {
      display: none;
    }
  }
</style>

<script define:vars={{ words }}>
  // Rotating word
  const el = document.getElementById('word');
  let i = 0;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  async function type(w) {
    for (let n = el.textContent.length; n >= 0; n--) {
      el.textContent = el.textContent.slice(0, n);
      await new Promise((r) => setTimeout(r, 35));
    }
    for (let n = 1; n <= w.length; n++) {
      el.textContent = w.slice(0, n);
      await new Promise((r) => setTimeout(r, 70));
    }
  }
  if (!reduce) {
    setInterval(() => {
      i = (i + 1) % words.length;
      type(words[i]);
    }, 2600);
  }
</script>

<script>
  // Cluster mesh: drifting nodes, live edges, packets in flight, cursor acts as a scheduler.
  const canvas = document.getElementById('mesh') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  type Node = { x: number; y: number; vx: number; vy: number; bx: number; by: number; r: number; gpu: boolean; phase: number };
  type Packet = { a: Node; b: Node; t: number; speed: number; color: string };

  let w = 0,
    h = 0,
    dpr = 1;
  let nodes: Node[] = [];
  let packets: Packet[] = [];
  const mouse = { x: -9999, y: -9999, active: false };
  const LINK = 150;

  function resize() {
    const nw = canvas.clientWidth;
    const nh = canvas.clientHeight;
    // Mobile browsers fire resize when the address bar shows/hides; don't reshuffle the mesh for that.
    if (nw === w && Math.abs(nh - h) < 120) return;
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    w = nw;
    h = nh;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const count = Math.round(Math.min(110, (w * h) / 13000));
    nodes = Array.from({ length: count }, () => {
      const gpu = Math.random() < 0.14;
      // Each node has its own cruising drift so the mesh keeps moving without a cursor (touch screens).
      const a = Math.random() * Math.PI * 2;
      const s = 0.12 + Math.random() * 0.18;
      return {
        x: Math.random() * w,
        y: Math.random() * h,
        vx: Math.cos(a) * s,
        vy: Math.sin(a) * s,
        bx: Math.cos(a) * s,
        by: Math.sin(a) * s,
        r: gpu ? 2.6 : 1.3 + Math.random() * 0.8,
        gpu,
        phase: Math.random() * Math.PI * 2,
      };
    });
    packets = [];
    if (reduce) requestAnimationFrame(frame);
  }

  function spawnPacket() {
    const a = nodes[(Math.random() * nodes.length) | 0];
    let best: Node | null = null;
    let bd = Infinity;
    for (const n of nodes) {
      if (n === a) continue;
      const d = Math.hypot(n.x - a.x, n.y - a.y);
      if (d < LINK && d < bd && Math.random() < 0.6) {
        bd = d;
        best = n;
      }
    }
    if (!best) return;
    const colors = ['#c6ff3d', '#3de0ff', '#8b7bff'];
    packets.push({ a, b: best, t: 0, speed: 0.008 + Math.random() * 0.014, color: colors[(Math.random() * 3) | 0] });
  }

  function frame(time: number) {
    ctx.clearRect(0, 0, w, h);

    for (const n of nodes) {
      if (mouse.active) {
        const dx = mouse.x - n.x,
          dy = mouse.y - n.y;
        const d = Math.hypot(dx, dy);
        if (d < 220 && d > 1) {
          n.vx += (dx / d) * 0.012;
          n.vy += (dy / d) * 0.012;
        }
      }
      n.vx += (n.bx - n.vx) * 0.015;
      n.vy += (n.by - n.vy) * 0.015;
      n.vx += (Math.random() - 0.5) * 0.01;
      n.vy += (Math.random() - 0.5) * 0.01;
      n.x += n.vx;
      n.y += n.vy;
      if (n.x < -20) n.x = w + 20;
      if (n.x > w + 20) n.x = -20;
      if (n.y < -20) n.y = h + 20;
      if (n.y > h + 20) n.y = -20;
    }

    ctx.lineWidth = 1;
    for (let i = 0; i < nodes.length; i++) {
      const a = nodes[i];
      for (let j = i + 1; j < nodes.length; j++) {
        const b = nodes[j];
        const d = Math.hypot(a.x - b.x, a.y - b.y);
        if (d < LINK) {
          let alpha = (1 - d / LINK) * 0.18;
          if (mouse.active) {
            const md = Math.hypot((a.x + b.x) / 2 - mouse.x, (a.y + b.y) / 2 - mouse.y);
            if (md < 200) alpha += (1 - md / 200) * 0.35;
          }
          ctx.strokeStyle = `rgba(160,170,200,${alpha})`;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }
    }

    for (const n of nodes) {
      if (n.gpu) {
        const p = (Math.sin(time / 600 + n.phase) + 1) / 2;
        ctx.fillStyle = `rgba(198,255,61,${0.08 + p * 0.12})`;
        ctx.beginPath();
        ctx.arc(n.x, n.y, 8 + p * 6, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#c6ff3d';
      } else {
        ctx.fillStyle = 'rgba(220,226,240,0.55)';
      }
      ctx.beginPath();
      ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
      ctx.fill();
    }

    if (packets.length < 26 && Math.random() < 0.25) spawnPacket();
    packets = packets.filter((p) => {
      p.t += p.speed;
      if (p.t >= 1) return false;
      const x = p.a.x + (p.b.x - p.a.x) * p.t;
      const y = p.a.y + (p.b.y - p.a.y) * p.t;
      ctx.shadowBlur = 12;
      ctx.shadowColor = p.color;
      ctx.fillStyle = p.color;
      ctx.beginPath();
      ctx.arc(x, y, 1.8, 0, Math.PI * 2);
      ctx.fill();
      ctx.shadowBlur = 0;
      return true;
    });

    running = !reduce && visible;
    if (running) requestAnimationFrame(frame);
  }

  let visible = true;
  let running = false;
  new IntersectionObserver(([e]) => {
    visible = e.isIntersecting;
    // A fast fling can toggle visibility before the old loop notices; never start a second loop.
    if (visible && !running && !reduce) {
      running = true;
      requestAnimationFrame(frame);
    }
  }).observe(canvas);

  window.addEventListener('pointermove', (e) => {
    // Touch has no hover; a lingering touch point would pull the whole mesh into one clump.
    if (e.pointerType !== 'mouse') return;
    const rect = canvas.getBoundingClientRect();
    mouse.x = e.clientX - rect.left;
    mouse.y = e.clientY - rect.top;
    mouse.active = mouse.y > 0 && mouse.y < rect.height;
  });
  window.addEventListener('pointerleave', () => (mouse.active = false));
  window.addEventListener('resize', resize);

  resize();
  if (!reduce) {
    running = true;
    requestAnimationFrame(frame);
  }
</script>
